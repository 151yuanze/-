# ============================================================
# 敏感信息配置模板
# ------------------------------------------------------------
# 1. 复制本文件为 application-env.yml（去掉 .example 后缀）
#    application-env.yml 已被 .gitignore 忽略，不会提交
# 2. 把下面的占位符改成你自己的真实值
# 3. 后端启动时会自动加载（application.yml 里 include: env）
# ============================================================

spring:
  datasource:
    # MySQL root 密码
    password: 你的MySQL密码

sky:
  jwt:
    # 管理端 / 用户端 JWT 签名密钥，随便一串足够长的随机字符，两者不要相同
    admin-secret-key: 你的管理端JWT密钥
    user-secret-key: 你的用户端JWT密钥

  redis:
    host: localhost
    port: 6379
    database: 0
    # Redis 没有设置密码就保持空字符串
    password: ""

  alioss:
    # 图片上传使用阿里云 OSS，需要先在控制台创建 Bucket
    endpoint: oss-cn-beijing.aliyuncs.com
    access-key-id: 你的AccessKeyId
    access-key-secret: 你的AccessKeySecret
    bucket-name: 你的Bucket名称

  wechat:
    appid: 你的小程序AppID
    secret: 你的小程序AppSecret
