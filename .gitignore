# ============================================================
# 苍穹外卖 —— 仓库根目录的忽略规则
# 原则：只提交「人写的源码和配置」，不提交能自动生成或下载来的东西
# ============================================================

# --- 依赖 / 构建产物（用 npm install、npm run build 能重新生成）---
node_modules/
dist/

# --- 便携版 Node 运行时（下载来的二进制，约 75MB，且只适用于 Windows）---
node16/

# --- nginx 本体（第三方软件，约 12MB，不该进仓库）---
# 用"先全排除、再逐个放行"的写法，只保留自己改过的 nginx.conf
nginx-1.24.0/*
!nginx-1.24.0/conf/
nginx-1.24.0/conf/*
!nginx-1.24.0/conf/nginx.conf

# --- IDE / 编辑器个人配置（每人机器上都不一样）---
.idea/
.vscode/
.history

# --- 临时备份文件 ---
*.bak

# --- 日志 ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- 构建分析报告（原项目自带的产物，含原作者的环境信息，不提交）---
report.*.json
